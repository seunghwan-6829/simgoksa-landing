{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "simgoksa.vercel.app" }],
      "destination": "https://simgoksa.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.simgoksa.com" }],
      "destination": "https://simgoksa.com/$1",
      "permanent": true
    }
  ]
}
